###### [ Discord Settings ] ########################
# Discord Developer Portal > Bot > Token
DISCORD_API_KEY='Bot API key' # Discord bot token
# Discord Developer Portal > General Info > Application ID
DISCORD_APPLICATION_ID='Bot application ID' # Discord application ID
# Discord Developer Portal > General Info > Public Key
DISCORD_PUBLIC_KEY='Public key' # Required for interaction endpoint verification

# Server and Channel Configuration
# Enable Developer Mode in Discord (Settings > Advanced) to get IDs
# Right-click on server/channel and select "Copy ID"
DISCORD_SERVER_ID='0' # Your Discord server ID
DISCORD_FORUM_CHANNEL_ID='0' # ID of your forum channel (e.g., #referendas)

# Optional Channels
# Public discussions channel for anonymous feedback (leave as '0' to disable)
DISCORD_PUBLIC_DISCUSSION_CHANNEL_ID='0'

# Summarizer channel for vote summaries (leave as '0' to disable)
DISCORD_SUMMARIZER_CHANNEL_ID='0'
DISCORD_SUMMARY_ROLE=''

###### [ Role Configuration ] ########################
# IMPORTANT: The bot looks for roles by NAME, not by ID
# Make sure these roles exist in your Discord server with EXACTLY these names

# Role that can participate in internal voting (e.g., dao-team-representative)
# If nothing is set, anyone can vote
DISCORD_VOTER_ROLE=''

# Role that can perform administrative commands (e.g., /network add)
DISCORD_ADMIN_ROLE='Admin'

# Role to notify when a new proposal is on the network
DISCORD_NOTIFY_ROLE='DOT-GOV'

# Role to notify when a vote has been cast onchain
DISCORD_EXTRINSIC_ROLE=''

###### [ Display Settings ] ########################
# These settings define the maximum length for thread titles and bodies
# It is strongly recommended to keep the default values
DISCORD_TITLE_MAX_LENGTH=95
DISCORD_BODY_MAX_LENGTH=2000

# Set to True to hide who voted for what, False to show usernames with votes
DISCORD_ANONYMOUS_MODE=True

###### [ Network Settings ] ########################
NETWORK_NAME='polkadot'
SYMBOL='DOT'

# Polkadot: 1e10 (10 decimals)
# Kusama:   1e12 (12 decimals)
TOKEN_DECIMAL=1e10

# RPC address (IBP favoured for stability)
SUBSTRATE_WSS='wss://polkadot.dotters.network'
PEOPLE_WSS='wss://people-polkadot.dotters.network'

###### [ Wallet Settings ] ########################
# SOLO_MODE=False automatic voting will be disabled.
# VOTE_WITH_BALANCE=0 will vote using the entire balance of the
# proxied address.
SOLO_MODE=True
PROXIED_ADDRESS='Address holding tokens that the gov proxy controls'
PROXY_ADDRESS='Gov proxy address'
MNEMONIC='Mnemonic to the governance proxy address that signs extrinsics'
# When VOTE_WITH_BALANCE is set to 0, the bot/governance proxy will vote with the entire balance
VOTE_WITH_BALANCE=1

# This option can be set to Locked1,2,3,4,5,6x
CONVICTION='Locked6x'

# This allows you to receive a wallet balance alert to a specific channel
# and at what balance to issue an alert at.
DISCORD_PROXY_BALANCE_ALERT='0' # channel id
PROXY_BALANCE_ALERT=1.1

# This setting allows you to set minimum participation percentage
# internally. If 90 people have DISCORD_VOTER_ROLE and only 6 people
# vote, then the default decision will be abstain.
# OPTIONAL: (Set to 0 to turn off minimum participation)
MIN_PARTICIPATION=0

# This setting defines THRESHOLD betwen AYE and NAY votes 
# to select quorum decision
#         aye_percentage = aye_votes / total_votes
#        nay_percentage = nay_votes / total_votes
#       if aye_percentage >= threshold:
#           return "aye"
#       elif nay_percentage >= threshold:
#           return "nay"
# If set to 0, then 0.66 used.
# Example: if set to 0.51 
# deicion with any bigger amount of votes will be selected 
# as soon as MIN_PARTICIPATION reached
THRESHOLD=0

###### [ VPS Configuration ] ########################
# Settings for SSH tunnel to VPS for Discord verification endpoint
# Used by connect_to_vps.sh script

# SSH username for VPS connection
VPS_USER='your-vps-username'

# VPS hostname or IP address
VPS_HOST='your-vps-hostname-or-ip'

# SSH port for VPS connection
VPS_PORT=22

# SSH private key file for VPS connection
VPS_PRIVATE_KEY_FILE='/Users/myusername/.ssh/your-private-key-file'

###### [ Database Configuration ] ########################
# Settings for PostgreSQL database connection
# These are used both for local development and Docker deployments

# Database name
DB_NAME=opengov_bot

# Database user
DB_USER=postgres

# Database password - set a secure password here
DB_PASSWORD='your_secure_password'

# Database host - use 'db' for Docker Compose, 'localhost' for local development
DB_HOST=localhost

# Database port
DB_PORT=5432
